# =============================================================================
# RAG Oposiciones — Environment Variables Template
# Copy this file to .env and fill in the values. NEVER commit .env with real values.
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
# Application name displayed in logs and API metadata
APP_NAME="RAG Oposiciones"
# Enable debug mode (true/false)
DEBUG=false
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ── LLM Provider ─────────────────────────────────────────────────────────────
# LLM provider to use (anthropic, openai, ollama)
LLM_PROVIDER=anthropic
# Model identifier (e.g. claude-3-5-sonnet-20241022, gpt-4o, llama3.2)
LLM_MODEL=claude-3-5-sonnet-20241022
# Sampling temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.1

# Anthropic API key (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI API key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here

# Ollama base URL (required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Groq API key (required if LLM_PROVIDER=groq)
GROQ_API_KEY=your-groq-api-key-here

# ── Embeddings ────────────────────────────────────────────────────────────────
# Embedding model name
EMBEDDING_MODEL=text-embedding-3-small
# Embedding vector dimension (must match the model)
EMBEDDING_DIM=1536

# ── Qdrant (Vector Database) ──────────────────────────────────────────────────
# Qdrant server URL
QDRANT_URL=http://localhost:6333
# Collection name for storing document embeddings
QDRANT_COLLECTION=oposiciones_temario

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# PostgreSQL credentials
POSTGRES_USER=opositor
POSTGRES_PASSWORD=opositor123
POSTGRES_DB=oposiciones_db
# Full async connection string (used by SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://opositor:opositor123@localhost:5432/oposiciones_db

# ── MinIO (Document Storage) ──────────────────────────────────────────────────
# MinIO server endpoint (host:port)
MINIO_ENDPOINT=localhost:9000
# MinIO root credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# MinIO access key (same as root user for local dev)
MINIO_ACCESS_KEY=minioadmin
# MinIO secret key (same as root password for local dev)
MINIO_SECRET_KEY=minioadmin123
# Bucket name for storing original documents
MINIO_BUCKET=temario-docs

# ── RAG Configuration ─────────────────────────────────────────────────────────
# Retriever type (dense, hybrid)
RETRIEVER_TYPE=hybrid
# Number of context chunks to retrieve per query
TOP_K=5
# Chunk size in tokens
CHUNK_SIZE=512
# Overlap between consecutive chunks in tokens
CHUNK_OVERLAP=64

# ── Langfuse (LLM Observability) ──────────────────────────────────────────────
# Langfuse server URL (self-hosted)
LANGFUSE_HOST=http://localhost:3000
# Langfuse project public key (get from Langfuse UI after first login)
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
# Langfuse project secret key (get from Langfuse UI after first login)
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
# Langfuse auth secret (used by Next.js auth, change in production)
LANGFUSE_SECRET=supersecret-change-in-production
# Langfuse salt for hashing (change in production)
LANGFUSE_SALT=salt-change-in-production
